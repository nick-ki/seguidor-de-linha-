// 1. MAPEAMENTO DE PINOS (Conforme caderno)

// Array com os pinos dos sensores (S1 a S8)
const int pinosSensores[8] = {16, 17, 18, 19, 21, 22, 23, 25};

// Pinos de controle da Ponte H (Motores)
const int IN1 = 26; // Motor Esquerdo - Frente
const int IN2 = 27; // Motor Esquerdo - Trás
const int IN3 = 32; // Motor Direito - Frente
const int IN4 = 33; // Motor Direito - Trás

// 2. CONFIGURAÇÕES DO PID E MOTORES

// Constantes do PID (VOCÊ PRECISARÁ AJUSTAR ESTES VALORES NA PRÁTICA)
float Kp = 50.0; // Resposta imediata ao erro -- Faz o robô tremer
float Ki = 0.1;  // Correção de erros acumulados (Geralmente 0 para seguidores rápidos) -- Faz o robô voltar pra linha
float Kd = 35.0; // Freio para evitar oscilações -- Suaviza o movimento do robô e faz o controle de velocidade nas curvas

// Variáveis de estado do PID
float P = 0, I = 0, D = 0;
float erro = 0;
float erro_anterior = 0;
float PID_value = 0;

// Velocidade
const int velocidade_base = 210; //linha reta
const int velocidade_max = 210;  //máxima permitida pela ponte H
const int velocidade_min = -180; //mínima (ré nas curvas fechadas)

// 3. FUNÇÃO SETUP (Configuração Inicial)

void setup() {
  Serial.begin(115200);

  for (int i = 0; i < 8; i++) {
    pinMode(pinosSensores[i], INPUT);
  }

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  acionarMotores(0, 0);
  
  delay(2000); // Aguarda começar a correr
}

// 4. LOOP PRINCIPAL

void loop() {
  //onde a linha está
  erro = calcularErro(); 

  //calcula correção necessária usando PID
  calcularPID(); 

  //ajustar as velocidades
  int velocidade_esq = velocidade_base + PID_value;
  int velocidade_dir = velocidade_base - PID_value;

  //limitar a velocidade (ponte H)
  velocidade_esq = constrain(velocidade_esq, velocidade_min, velocidade_max);
  velocidade_dir = constrain(velocidade_dir, velocidade_min, velocidade_max);

  //enviar para motores
  acionarMotores(velocidade_esq, velocidade_dir);
}

// 5. FUNÇÕES AUXILIARES

float calcularErro() {
  int posicao_soma = 0;
  int sensores_ativos = 0;

   int pesos[8] = {-35, -25, -15, -5, 5, 15, 25, 35};

  for (int i = 0; i < 8; i++) {
       bool vendo_linha = (digitalRead(pinosSensores[i]) == HIGH); 
    
    if (vendo_linha) {
      posicao_soma += pesos[i];
      sensores_ativos++;
    }
  }

    if (sensores_ativos == 0) {
    return erro_anterior; 
  }

  return (float)posicao_soma / sensores_ativos;
}

void calcularPID() {
  P = erro;
  I = I + erro; // Acumula o erro
  D = erro - erro_anterior; // Diferença entre o erro atual e o passado
  
  PID_value = (Kp * P) + (Ki * I) + (Kd * D);
  
  // Guarda o erro para o próximo ciclo
  erro_anterior = erro; 
}

void acionarMotores(int velEsq, int velDir) {

  // ---- Motor Esquerdo ----
  if (velEsq >= 0) {
    // Frente
    analogWrite(IN1, velEsq);
    analogWrite(IN2, 0);
  } else {
    // Trás (Inverte os pinos e converte o valor para positivo)
    analogWrite(IN1, 0);
    analogWrite(IN2, abs(velEsq)); 
  }

  // ---- Motor Direito ----
  if (velDir >= 0) {
    // Frente
    analogWrite(IN3, velDir);
    analogWrite(IN4, 0);
  } else {
    // Trás
    analogWrite(IN3, 0);
    analogWrite(IN4, abs(velDir));
  }
}

void imprimirSensores() {
  Serial.print("Sensores: ");
  for (int i = 0; i < 8; i++) {
    Serial.print(digitalRead(pinosSensores[i]));
    Serial.print(" ");
  }
  
  Serial.print("| Erro: ");
  Serial.print(erro);
  Serial.print(" | PID: ");
  Serial.println(PID_value);
}
